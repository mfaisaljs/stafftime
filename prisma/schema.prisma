generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum EmployeeRole {
  OWNER
  REGIONAL_MANAGER
  STORE_MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TimeEntryStatus {
  OPEN
  CLOSED
  PENDING_APPROVAL
}

enum BreakType {
  PAID
  UNPAID
  LUNCH
}

enum MissedPunchType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum MissedPunchStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollExportFormat {
  CSV
  EXCEL
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id        String   @id @default(cuid())
  domain    String   @unique
  name      String?
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations           StoreLocation[]
  employees           Employee[]
  shifts              Shift[]
  timeEntries         TimeEntry[]
  missedPunches       MissedPunchRequest[]
  auditLogs           AuditLog[]
  devices             Device[]
  payrollExports      PayrollExport[]
  payrollPayments     PayrollPayment[]
  settings            Setting?
  commissionPrograms  CommissionProgram[]
  salesTargets        SalesTarget[]
  salesTargetSnapshots SalesTargetSnapshot[]
  salesTargetAttributions SalesTargetAttribution[]
  commissionAttributions CommissionAttribution[]
  taskLists           TaskList[]
  taskListCompletions TaskListCompletion[]
  timeOffPolicies     TimeOffPolicy[]
  timeOffRequests     TimeOffRequest[]
}

model StoreLocation {
  id                String   @id @default(cuid())
  shopId            String
  shopifyLocationId String
  name              String
  timezone          String   @default("UTC")
  latitude          Float?
  longitude         Float?
  geofenceRadiusM   Int      @default(100)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  shop        Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  employees   Employee[]
  shifts      Shift[]
  timeEntries TimeEntry[]
  devices     Device[]

  @@unique([shopId, shopifyLocationId])
}

model Employee {
  id                 String         @id @default(cuid())
  shopId             String
  locationId         String?
  firstName          String
  lastName           String
  email              String?
  phone              String?
  pinHash            String
  qrCode             String         @unique
  role               EmployeeRole   @default(EMPLOYEE)
  status             EmployeeStatus @default(ACTIVE)
  firstLoginAt       DateTime?
  hourlyRate         Float          @default(0)
  position           String?
  department         String?
  locationAccess     String         @default("ALL")
  currency           String         @default("USD")
  payrollType        String         @default("HOURLY")
  salaryAmount       Float          @default(0)
  weeklyAvailability String?
  paymentMethod      String         @default("PAYPAL")
  paypalEmail        String?
  paypalAccountName  String?
  bankAccountType    String?
  bankName           String?
  accountHolderName  String?
  accountNumber      String?
  routingNumber      String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  shop          Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location      StoreLocation?       @relation(fields: [locationId], references: [id])
  shifts          Shift[]
  timeEntries     TimeEntry[]
  missedPunches   MissedPunchRequest[]
  payrollPayments PayrollPayment[]

  @@index([shopId, status])
}

model Shift {
  id         String   @id @default(cuid())
  shopId     String
  locationId String
  employeeId String
  startsAt   DateTime
  endsAt     DateTime
  notes      String?
  status     String   @default("SCHEDULED")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([shopId, startsAt])
  @@index([employeeId, startsAt])
  @@index([shopId, status, startsAt])
}

model CommissionProgram {
  id                   String   @id @default(cuid())
  shopId               String
  name                 String
  commissionType       String   @default("fixed")
  afterDiscount        Boolean  @default(true)
  limitedTime          Boolean  @default(false)
  startDate            String?
  endDate              String?
  productScope         String   @default("all")
  allProductsCommission Float?
  productCommissions   String   @default("[]")
  employeeIds          String   @default("[]")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

/// One commission attribution per shop order (credits staff from program product rules).
model CommissionAttribution {
  id                   String   @id @default(cuid())
  shopId               String
  employeeId           String
  orderId              String
  orderName            String?
  /// Shopify order displayFinancialStatus (e.g. PAID), not staff payout status.
  orderFinancialStatus String   @default("PAID")
  commissionTotal      Float
  currency             String   @default("USD")
  programIds           String   @default("[]")
  lineItemsJson        String   @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
  @@index([shopId, employeeId, createdAt])
}

model SalesTarget {
  id           String   @id @default(cuid())
  shopId       String
  yearMonth    String
  amount       Float
  currency     String   @default("USD")
  employeeIds  String   @default("[]")
  locationIds  String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, yearMonth])
}

/// Monthly goal snapshot per staff member so history keeps the target amount over time.
model SalesTargetSnapshot {
  id         String   @id @default(cuid())
  shopId     String
  employeeId String
  yearMonth  String
  amount     Float
  currency   String   @default("USD")
  soldAmount Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, employeeId, yearMonth])
  @@index([shopId, employeeId, yearMonth])
}

/// One POS order attribution per shop order (credits soldAmount on staff snapshot).
model SalesTargetAttribution {
  id           String   @id @default(cuid())
  shopId       String
  employeeId   String
  orderId      String
  orderName    String?
  amount       Float
  currency     String   @default("USD")
  yearMonth    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, orderId])
  @@index([shopId, employeeId, yearMonth])
}

model TimeEntry {
  id         String          @id @default(cuid())
  shopId     String
  locationId String
  employeeId String
  clockInAt  DateTime
  clockOutAt DateTime?
  status     TimeEntryStatus @default(OPEN)
  hourlyRateSnapshot Float?
  source     String          @default("POS")
  deviceId   String?
  latitude   Float?
  longitude  Float?
  photoUrl   String?
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  employee Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breaks   BreakEntry[]

  @@index([shopId, clockInAt])
  @@index([employeeId, status])
}

model BreakEntry {
  id          String    @id @default(cuid())
  timeEntryId String
  type        BreakType @default(UNPAID)
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  timeEntry TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  @@index([timeEntryId, endedAt])
}

model MissedPunchRequest {
  id          String            @id @default(cuid())
  shopId      String
  employeeId  String
  type        MissedPunchType
  requestedAt DateTime
  reason      String?
  status      MissedPunchStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([shopId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  shopId     String
  actorId    String?
  actorType  String   @default("system")
  action     String
  entityType String
  entityId   String
  previous   String?
  next       String?
  ipAddress  String?
  deviceId   String?
  createdAt  DateTime @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, createdAt])
}

model Device {
  id         String    @id @default(cuid())
  shopId     String
  locationId String?
  name       String
  deviceKey  String    @unique
  approved   Boolean   @default(false)
  locked     Boolean   @default(false)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shop     Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  location StoreLocation? @relation(fields: [locationId], references: [id])

  @@index([shopId, approved])
}

model PayrollExport {
  id          String              @id @default(cuid())
  shopId      String
  format      PayrollExportFormat @default(CSV)
  periodStart DateTime
  periodEnd   DateTime
  filePath    String?
  createdAt   DateTime            @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model PayrollPayment {
  id            String   @id @default(cuid())
  shopId        String
  employeeId    String
  paymentType   String   @default("SALARY")
  amount        Float
  currency      String   @default("USD")
  paymentMethod String   @default("PAYPAL")
  notes         String?
  proofFileName String?
  periodLabel   String?
  periodStart   String?
  periodEnd     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([shopId, employeeId, createdAt])
}

model TaskList {
  id             String   @id @default(cuid())
  shopId         String
  name           String
  description    String?
  active         Boolean  @default(true)
  assignStaff    Boolean  @default(false)
  assignManagers Boolean  @default(false)
  staffScope     String   @default("ALL")
  managerScope   String   @default("ALL")
  employeeIds    String   @default("[]")
  managerIds     String   @default("[]")
  locationAccess String   @default("ALL")
  locationIds    String   @default("[]")
  timelines      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shop         Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items        TaskListItem[]
  completions  TaskListCompletion[]

  @@index([shopId, createdAt])
}

model TaskListItem {
  id         String   @id @default(cuid())
  taskListId String
  title      String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  taskList    TaskList             @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  completions TaskListCompletion[]

  @@index([taskListId, sortOrder])
}

model TaskListCompletion {
  id          String   @id @default(cuid())
  shopId      String
  taskListId  String
  taskItemId  String
  dateKey     String
  performedBy String?
  performedAt DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shop     Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  taskList TaskList     @relation(fields: [taskListId], references: [id], onDelete: Cascade)
  taskItem TaskListItem @relation(fields: [taskItemId], references: [id], onDelete: Cascade)

  @@unique([taskItemId, dateKey])
  @@index([taskListId, dateKey])
  @@index([shopId, dateKey])
}

model TimeOffPolicy {
  id              String   @id @default(cuid())
  shopId          String
  name            String
  policyType      String   @default("TIME_OFF")
  compensation    String   @default("UNPAID")
  fullDayDuration Float    @default(8)
  employeeIds     String   @default("[]")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shop     Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  requests TimeOffRequest[]

  @@index([shopId, createdAt])
}

model TimeOffRequest {
  id         String   @id @default(cuid())
  shopId     String
  employeeId String
  policyId   String
  locationId String?
  startDate  String
  endDate    String
  reason     String?
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop     Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  policy   TimeOffPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([shopId, status, createdAt])
  @@index([employeeId, startDate])
}

model Setting {
  id                    String   @id @default(cuid())
  shopId                String   @unique
  overtimeDailyHours    Float    @default(8)
  overtimeWeeklyHours   Float    @default(40)
  maxHoursPerDay        Float    @default(12)
  maxHoursPerWeek       Float    @default(60)
  mandatoryBreakHours   Float    @default(6)
  mandatoryBreakMinutes Int      @default(30)
  requireGps            Boolean  @default(false)
  requirePhoto          Boolean  @default(false)
  scheduleLocationColors String   @default("{}")
  scheduleStaffColors    String   @default("{}")

  // Clock event settings
  deductBreakTime              Boolean @default(true)
  salaryAfterFirstClockIn      Boolean @default(true)
  blockBreakAfterEndTime       Boolean @default(false)
  allowEarlyClockIn            Boolean @default(true)
  earlyClockInMinutes          Int     @default(30)
  showPayrollStatsInPos        Boolean @default(true)
  timeFormat                   String  @default("24H")
  hourFormat                   String  @default("STANDARD")

  // Absence calculation settings
  excludePaidLeavesFromAbsences      Boolean @default(true)
  includeUnpaidLeavesInAbsences      Boolean @default(true)
  autoAddPaidLeavesToSalary          Boolean @default(true)
  autoDeductUnpaidLeavesFromSalary   Boolean @default(true)
  autoDeductAbsencesFromSalary       Boolean @default(true)
  defaultDailyWorkingHours           Float   @default(8)

  // Holiday rules (JSON weekday list, e.g. ["SUNDAY"])
  holidayWeekdays String @default("[\"SUNDAY\"]")

  // Staff portal feature flags
  portalClockIn        Boolean @default(true)
  portalManagerView    Boolean @default(true)
  portalTimeOff        Boolean @default(true)
  portalProfileShifts  Boolean @default(true)
  portalTaskList       Boolean @default(true)
  portalViewShifts     Boolean @default(true)
  portalTimesheet      Boolean @default(true)
  portalCreateShift    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}
